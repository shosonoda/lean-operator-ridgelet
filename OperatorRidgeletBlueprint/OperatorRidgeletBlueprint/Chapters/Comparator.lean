    ∀ a : H, MemLp (fun c : ℝ => ridgelet μ ρ f (a, c)) 2 volume ∧
      ∫ c : ℝ, ‖ridgelet μ ρ f (a, c)‖ ^ 2 ≤ (∫ x, ‖f x‖ ^ 2 ∂μ) * ∫ t : ℝ, ‖ρ t‖ ^ 2 := by
